pipeline {
    agent any

    options {
        timestamps()
        timeout(time: 60, unit: 'MINUTES')
    }

    environment {
        TOOLBOX = 'ci-tools:local'
    }

    stages {
        stage('Toolbox') {
            steps {
                sh 'docker build -t $TOOLBOX -f CI/jenkins/outils/Dockerfile.secgate CI/jenkins/outils/'
            }
        }

        stage('check des sources') {
            parallel {
                stage('Secrets avec Gitleaks') {
                    steps { securiteApplicative 'gitleaks git --redact --verbose .' }
                }
                stage('Dockerfile avec Hadolint') {
                    steps { securiteApplicative 'hadolint --failure-threshold warning CI/Dockerfile.harden' }
                }
                stage('SAST (Semgrep)') {
                    steps { securiteApplicative 'semgrep scan --config p/default --error  App/' }
                }
                stage('Dependences (OSV)') {
                    steps { securiteApplicative 'osv-scanner scan source -r .' }
                }
            }
        }

        stage('build image') {
            steps {
                sh '''
                    mkdir -p images reports
                    docker build -t devsecops/app:$GIT_COMMIT -f CI/Dockerfile.harden App
                    docker save -o images/app.tar devsecops/app:$GIT_COMMIT
                '''
            }
        }

        stage('image check') {
            parallel {
                stage('check avec syft') {
                    steps {
                        securiteApplicative 'syft docker-archive:images/app.tar -o cyclonedx-json=reports/app.sbom.cdx.json'
                    }
                }
                stage('dockle check') {
                    steps {
                        securiteApplicative 'dockle --input images/app.tar --exit-code 1 --exit-level warn'
                    }
                }
                stage('check avec trivy') {
                    steps {
                        securiteApplicative 'trivy image --input images/app.tar --cache-dir /trivy-cache --skip-db-update --severity CRITICAL,HIGH --ignore-unfixed --exit-code 1'
                    }
                }
            }
        }
        stage('publish') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'dockerhub-pat',
                                    usernameVariable: 'REG_USER',
                                    passwordVariable: 'REG_TOKEN'),
                    string(credentialsId: 'dockerhub-repo', variable: 'DOCKERHUB_REPO')
                ]) {
                    sh ''' 
                        IMAGE=$REG_USER/$DOCKERHUB_REPO
                        docker tag devsecops/app:$GIT_COMMIT $IMAGE:$GIT_COMMIT
                        echo "$REG_TOKEN" | docker login -u "$REG_USER" --password-stdin
                        docker push $IMAGE:$GIT_COMMIT | tee reports/push.log
                        docker logout
                        DIGEST=$(awk '/digest: sha256:/ {print $3}' reports/push.log)
                        echo "$IMAGE@$DIGEST" > reports/app.digest
                    '''
                }
            }
        }

        stage('signature et verification') {
            steps {
                withCredentials([
                    usernamePassword(credentialsId: 'dockerhub-pat',
                                    usernameVariable: 'REG_USER',
                                    passwordVariable: 'REG_TOKEN'),
                    file(credentialsId: 'cosign-cle', variable: 'COSIGN_KEYFILE'),
                    string(credentialsId: 'cosign-mdp', variable: 'COSIGN_PASSWORD')
                ]) {
                    securiteApplicative '''
                        REF=$(cat reports/app.digest)
                        echo "$REG_TOKEN" | cosign login docker.io -u "$REG_USER" --password-stdin
                        cosign sign --key "$COSIGN_KEYFILE" --yes --new-bundle-format=false --use-signing-config=false "$REF"
                        cosign tree "$REF"
                        cosign verify --key CI/cosign.pub "$REF"
                    '''
                }
            }
        }
    }

    post {
        always { archiveArtifacts artifacts: 'reports/**', allowEmptyArchive: true }
    }
}

// securiteApplicative: execution commande dans le toolbox image, elle es dans outils/Dockerfile.secgate
def securiteApplicative(String command) {
    echo "commande: ${command}"
    docker.image(env.TOOLBOX).inside('-e HOME=/tmp -v /var/jenkins_home/trivy-cache:/trivy-cache') {
        sh command
    }
    echo "c bon"
}