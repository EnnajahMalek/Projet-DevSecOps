pipeline {
    agent any

    options {
        timestamps() 
    }

    environment {
        TOOLBOX = 'ci-tools:local'
    }

    stages {
        stage('Toolbox') {
            steps {
                sh 'docker build -t $TOOLBOX -f CI-CD/jenkins/outils/Dockerfile.secgate CI-CD/jenkins/outils/'
            }
        }

        stage('Source checks') {
            parallel {
                stage('Secrets (Gitleaks)') {
                    steps { securiteApplicative 'gitleaks git --redact --verbose .' }
                }
                stage('Dockerfiles (Hadolint)') {
                    steps { securiteApplicative 'hadolint --failure-threshold warning CI-CD/Dockerfile' }
                }
            }
        }
 
    }
} 
def securiteApplicative(String command) {
    echo "commande: ${command}"
    docker.image(env.TOOLBOX).inside('-e HOME=/tmp') {
        sh command
    }
    echo "c bon"
}