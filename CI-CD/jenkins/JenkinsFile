pipeline {
    agent any
    environment {
        DOCKER_IMAGE = 'dev-build'
        PUBLISH_IMAGE = 'publish.build'
        // DOCKER_TAG = "${env.BUILD_NUMBER}"
        // SONAR_TOKEN = credentials('sonar-token-id')
        // NVD_API_KEY = credentials('nvd-api-key')
        // DOCKER_SCOUT_TOKEN = credentials('docker-scout-token')
        // DOCKERHUB_USER = credentials('dockerhub-user')
        // DOCKERHUB_PAT = credentials('dockerhub-token')
    }
    options {
        timestamps()
    }

    stages {
        stage('Build') {
            steps {
                dir('App') {
                    sh 'npm ci'
                }
            }
        }
        stage('Unit tests') {
            steps {
                dir('App') {
                    sh 'npm test'
                }
            }
            post {
                always {
                    junit 'App/junit.xml'
                }
            }
        }
    }

    post {
        always {
            echo "Pipeline status: ${currentBuild.currentResult}"
        }
    }
}
