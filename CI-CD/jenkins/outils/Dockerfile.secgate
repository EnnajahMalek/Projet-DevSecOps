FROM debian:12-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

ARG GITLEAKS_VERSION=8.30.1
ARG TRIVY_VERSION=0.76.1
ARG SYFT_VERSION=1.55.0 
ARG HADOLINT_VERSION=2.15.1
ARG DOCKLE_VERSION=0.4.15
 
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git python3 python3-venv \
    && rm -rf /var/lib/apt/lists/* \
    && git config --system --add safe.directory '*'

WORKDIR /tmp/dl

# 1. Gitleaks
RUN curl -sSfLO https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz \
 && curl -sSfLO https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/gitleaks_${GITLEAKS_VERSION}_checksums.txt \
 && sha256sum --ignore-missing -c gitleaks_${GITLEAKS_VERSION}_checksums.txt \
 && tar -xzf gitleaks_${GITLEAKS_VERSION}_linux_x64.tar.gz -C /usr/local/bin gitleaks \
 && rm -f /tmp/dl/*

# 2. Trivy
RUN curl -sSfLO https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz \
 && curl -sSfLO https://github.com/aquasecurity/trivy/releases/download/v${TRIVY_VERSION}/trivy_${TRIVY_VERSION}_checksums.txt \
 && sha256sum --ignore-missing -c trivy_${TRIVY_VERSION}_checksums.txt \
 && tar -xzf trivy_${TRIVY_VERSION}_Linux-64bit.tar.gz -C /usr/local/bin trivy \
 && rm -f /tmp/dl/*

# 3. Syft
RUN curl -sSfLO https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_linux_amd64.tar.gz \
 && curl -sSfLO https://github.com/anchore/syft/releases/download/v${SYFT_VERSION}/syft_${SYFT_VERSION}_checksums.txt \
 && sha256sum --ignore-missing -c syft_${SYFT_VERSION}_checksums.txt \
 && tar -xzf syft_${SYFT_VERSION}_linux_amd64.tar.gz -C /usr/local/bin syft \
 && rm -f /tmp/dl/*

 

# 4. Hadolint   
RUN curl -sSfLO https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/hadolint-linux-x86_64 \
 && curl -sSfLO https://github.com/hadolint/hadolint/releases/download/v${HADOLINT_VERSION}/checksums.sha256 \
 && sha256sum --ignore-missing -c checksums.sha256 \
 && install -m 0755 hadolint-linux-x86_64 /usr/local/bin/hadolint \
 && rm -f /tmp/dl/*

# 5.  Dockle
RUN curl -sSfLO https://github.com/goodwithtech/dockle/releases/download/v${DOCKLE_VERSION}/dockle_${DOCKLE_VERSION}_Linux-64bit.tar.gz \
 && curl -sSfLO https://github.com/goodwithtech/dockle/releases/download/v${DOCKLE_VERSION}/dockle_${DOCKLE_VERSION}_checksums.txt \
 && sha256sum --ignore-missing -c dockle_${DOCKLE_VERSION}_checksums.txt \
 && tar -xzf dockle_${DOCKLE_VERSION}_Linux-64bit.tar.gz -C /usr/local/bin dockle \
 && rm -f /tmp/dl/*
